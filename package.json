{
  "name": "launcher",
  "version": "1.6.0",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Лучший ЛАУНЧИР НА ПЛАНИТЕЕЕЕЕЕ!!!!!!!!",
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "globals": "^15.9.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "async": "^3.2.6",
    "axios": "^1.7.8",
    "check-disk-space": "^3.4.0",
    "discord-rpc": "^4.0.1",
    "is-elevated": "^4.0.0",
    "lodash.throttle": "^4.1.1",
    "p-limit": "^2.3.0",
    "ps-list": "^8.1.1",
    "shortcut": "^0.0.4",
    "sudo-prompt": "^9.2.1",
    "windows-shortcuts": "^0.1.6",
    "yauzl": "^3.2.0"
  },
  "build": {
    "appId": "com.zhekarik.launcher",
    "productName": "launcher",
    "icon": "public/assets/icons/launcher-icon_.ico",
    "win": {
      "target": "portable",
      "icon": "public/assets/icons/launcher-icon_.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe",
      "useZip": true,
      "requestExecutionLevel": "admin"
    },
    "asar": false,
    "compression": "maximum"
  }
}
