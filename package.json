{
  "name": "zhekarikstrike-launcher-tauri",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:frontend": "vite build",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test:release-script": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/release-password.ps1",
    "test:e2e:browser": "cross-env VITE_TAURI_E2E=browser start-test serve:e2e http://127.0.0.1:5173/public/intro.html wdio:browser",
    "serve:e2e": "vite --host 127.0.0.1 --port 5173",
    "wdio:browser": "wdio run wdio.browser.conf.js",
    "test:e2e:tauri": "npm run build:e2e:tauri && wdio run wdio.tauri.conf.js",
    "build:e2e:tauri": "cross-env VITE_TAURI_E2E=native tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "format": "prettier --write src public"
  },
  "keywords": [],
  "author": "d3affy",
  "license": "ISC",
  "description": "ZHEKARIK STRIKE Launcher",
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@tauri-apps/cli": "^2.0.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "start-server-and-test": "^2.1.5",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "three": "^0.180.0"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  }
}
