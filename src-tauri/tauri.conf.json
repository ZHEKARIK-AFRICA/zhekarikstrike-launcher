{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZHEKARIK STRIKE",
  "version": "1.6.1",
  "identifier": "com.zhekarik.launcher",
  "build": {
    "beforeDevCommand": "vite --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173/public/intro.html",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ZHEKARIK STRIKE",
        "url": "public/intro.html",
        "width": 892,
        "height": 496,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/launcher-icon.ico"],
    "resources": [
      "../public/game_files",
      "../public/game_files_pure"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/launcher-icon.ico",
        "installMode": "perMachine",
        "languages": ["Russian", "English"]
      }
    }
  }
}
